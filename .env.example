# Content source: github (default) or telegram
SOURCE=telegram

# --- Telegram inbox mode (SOURCE=telegram, used by GitHub Actions) ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Numeric chat IDs allowed to submit posts (comma-separated). Required for telegram source.
# Get your chat id by messaging the bot, then calling getUpdates once locally, or use @userinfobot.
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional outbound Telegram channel/chat (only used if TELEGRAM_REPOST=true)
TELEGRAM_CHAT_ID=
TELEGRAM_REPOST=false

# --- GitHub repo mode (SOURCE=github) ---
# GITHUB_USERNAME="your_github_username"
# GITHUB_TOKEN="your_github_personal_access_token_with_repo_scope"
# POSTS_REPO_URL="https://github.com/MY_USERNAME/my_posts.git"
# POSTS_REPO_PATH="/app/my_posts_data"
# PUBLISH_ADDED_ONLY=true

STATE_FILE_PATH=.state/.social_poster_state
DELIVERIES_FILE_PATH=.state/.social_poster_deliveries.json

# Optional: absolute path to env file (overrides cwd/.env discovery)
# ENV_FILE=/path/to/.env

# Local/docker continuous mode. GitHub Actions uses --once on a cron schedule instead.
PROCESS_INTERVAL=0

DRY_RUN=false

# Outbound platforms (configure at least one for SOURCE=telegram)
TWITTER_API_KEY=
TWITTER_API_SECRET_KEY=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

MASTODON_SERVER=
MASTODON_ACCESS_TOKEN=

DEV_TO_API_KEY=

LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
